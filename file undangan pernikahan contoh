<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Undangan Pernikahan</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      font-family: 'Georgia', serif;
      text-align: center;
      color: #f5f5f5;
      background:
        linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)),
        url("https://images.unsplash.com/photo-1526045612212-70caf35c14df?auto=format&fit=crop&w=1200&q=80");
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    /* COVER */
    #cover {
      position: fixed;
      inset: 0;
      background:
        linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.75)),
        url("https://images.unsplash.com/photo-1526045612212-70caf35c14df?auto=format&fit=crop&w=1200&q=80");
      background-size: cover;
      background-position: center;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    #cover .inner {
      background: rgba(20,20,20,0.85);
      padding: 45px 30px;
      border-radius: 22px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
      animation: fadeUp 1s ease;
    }

    #cover h1 {
      margin: 10px 0;
      letter-spacing: 2px;
      color: #e0c68f;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(25px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .container {
      padding: 40px 15px;
      max-width: 600px;
      margin: auto;
    }

    .box {
      background: rgba(25,25,25,0.88);
      border-radius: 18px;
      padding: 25px 20px;
      margin: 25px 0;
      box-shadow: 0 12px 30px rgba(0,0,0,0.5);
      border: 1px solid rgba(224,198,143,0.2);
    }

    h1, h2, h3 {
      color: #e0c68f;
      letter-spacing: 1px;
    }

    .countdown {
      font-size: 18px;
      font-weight: bold;
      margin-top: 10px;
    }

    a.button {
      display: inline-block;
      margin-top: 15px;
      padding: 14px 28px;
      background: linear-gradient(135deg, #e0c68f, #f5deb3);
      color: #0f0f0f;
      text-decoration: none;
      border-radius: 30px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    input {
      padding: 12px;
      width: 85%;
      border-radius: 30px;
      border: none;
      margin-top: 10px;
      text-align: center;
    }

    footer {
      font-size: 12px;
      color: #ccc;
      margin: 40px 0 20px;
    }
  </style>
</head>
<body>

<!-- COVER -->
<div id="cover" onclick="bukaUndangan()">
  <div class="inner">
    <p>THE WEDDING OF</p>
    <h1>Ahmad & Aisyah</h1>
    <p>Minggu, 10 Maret 2026</p>
    <small>(Tap layar untuk membuka)</small>
  </div>
</div>

<div class="container">
  <h2>Undangan Pernikahan</h2>
  <h1>Ahmad & Aisyah</h1>

  <div class="box">
    <h3>Akad & Resepsi</h3>
    <p>Minggu, 10 Maret 2026</p>
    <p>Pukul 09.00 WIB</p>
    <div class="countdown" id="countdown"></div>
  </div>

  <div class="box">
    <h3>Lokasi Acara</h3>
    <p>Gedung Serbaguna Bahagia</p>
    <a class="button" href="https://www.google.com/maps/place/Gedung+serbaguna+Graha+Kusuma/@-6.9824247,107.5513576,17z/data=!3m1!4b1!4m6!3m5!1s0x2e68ef09bd5e909d:0xae400f5197183af5!8m2!3d-6.9824247!4d107.5539325!16s%2Fg%2F11hznkswjr?hl=id&entry=ttu&g_ep=EgoyMDI1MTIwOS4wIKXMDSoASAFQAw%3D%3D"
    target="_blank">
       Buka Google Maps
    </a>
  </div>

  <div class="box">
    <h3>Konfirmasi Kehadiran</h3>
    <input type="text" id="nama" placeholder="Masukkan nama Anda">
    <br>
    <a class="button" onclick="kirimWA()">Konfirmasi via WhatsApp</a>
  </div>

  <footer>© 2026 Premium Wedding Invitation</footer>
</div>

<script>
  function bukaUndangan() {
    document.getElementById("cover").style.display = "none";
  }

  const targetDate = new Date("March 10, 2026 09:00:00").getTime();
  const countdown = document.getElementById("countdown");

  setInterval(() => {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      countdown.innerHTML = "Acara telah dimulai";
      return;
    }

    const d = Math.floor(distance / (1000*60*60*24));
    const h = Math.floor((distance % (1000*60*60*24))/(1000*60*60));
    const m = Math.floor((distance % (1000*60*60))/(1000*60));
    const s = Math.floor((distance % (1000*60))/1000);

    countdown.innerHTML = `${d} hari ${h} jam ${m} menit ${s} detik`;
  }, 1000);

  function kirimWA() {
    const nama = document.getElementById("nama").value || "Tamu";
    const pesan = `Halo, saya ${nama} ingin mengonfirmasi kehadiran di acara pernikahan.;
    const url = "https://wa.me/6283168245059?text=${encodeURIComponent(pesan)};
    window.open(url, "_blank");
  }
</script>

</body>
</html>
